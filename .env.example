# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LTA_ACCOUNT_KEY: Primary secret AccountKey header for LTA DataMall API (Vercel Environment Variable)
# Configure this key in your Vercel Dashboard -> Settings -> Environment Variables as: LTA_ACCOUNT_KEY
LTA_ACCOUNT_KEY=""
